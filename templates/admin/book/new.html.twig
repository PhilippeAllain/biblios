{% extends 'base.html.twig' %}

{% set action = app.current_route == 'app_admin_book_new' ? 'Ajout' : 'Édition' %}

{% block title %}
	{{ action }}
	de livre
{% endblock %}

{% block body %}
	<section class="container px-4">
		<div class="w-100 m-auto">
			<h1 class="text-center m-5 p-5">{{ action }}
				de livre</h1>

			{{ form_start(form) }}
			<div class="container">
				<div class="row">
					<div class="col-6">
						{{ form_row(form.title, {label: 'Titre'}) }}
					</div>
					<div class="col-6">
						{{ form_row(form.isbn, {label: 'Numéro ISBN'}) }}
					</div>
				</div>
                <div class="row">
                    <div class="col-6">
				{{ form_row(form.cover, {label: 'Couverture (lien URL)'}) }}
                </div>
                    <div class="col-6"> 
				{{ form_row(form.editedAt, {label: "Date d'édition"}) }}
                    </div>
                </div>
				{{ form_row(form.plot, {label: 'Synopsis'}) }}
                <div class="row">
                    <div class="col-6">
				{{ form_row(form.pageNumber, {label: 'Nombre de pages'}) }}
                    </div>
                    <div class="col-6">
                {{ form_row(form.status, {label: 'Statut'}) }}
                    </div>
                </div>
				<div class="row">
                    <div class="col-6">
                        {{ form_row(form.editor, {label: 'Éditeur'}) }}
                    </div>
                    <div class="col-6">
                        {{ form_row(form.authors, {label: 'Auteurs'}) }}
                    </div>
				
				<div class="d-grid gap-2 col-4 mx-auto">
				<button type="submit" class="btn btn-primary">Envoyer</button>
                </div>
				{{ form_end(form) }}
			</div>
		</section>
	{% endblock %}
